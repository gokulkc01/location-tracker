# Backend API URL (for ngrok, use full URL without /api)
# Example: VITE_API_URL=https://your-ngrok-url.ngrok-free.dev/api
VITE_API_URL=http://localhost:5000/api

# Socket URL (same as backend but without /api)
# Example: VITE_SOCKET_URL=https://your-ngrok-url.ngrok-free.dev
VITE_SOCKET_URL=http://localhost:5000
